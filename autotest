#!/usr/bin/env bash
#
# Usage:
#   ./autotest              run every problem
#   ./autotest is_sorted    run one problem
#   ./autotest linked_list  run every problem in a topic

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOPICS="linked_list bst graph hashmap stack_queue bonus"
TIME_LIMIT=5

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Unbuffered stdout keeps the PASS/FAIL lines printed before a crash.
cat > "$TMP/unbuffered.c" <<'EOF'
#include <stdio.h>
__attribute__((constructor)) static void unbuffered(void) {
    setvbuf(stdout, NULL, _IONBF, 0);
}
EOF

shopt -s nullglob
FILES=()
for topic in $TOPICS; do
    FILES+=("$ROOT/$topic"/*.c)
done

total_passed=0
total_tests=0

run_problem() {
    local file="$1"
    local name
    name="$(basename "$file" .c)"
    local testFile
    testFile="$ROOT/tests/$(basename "$(dirname "$file")")/$name.c"
    local tests
    tests="$(grep -cE '^[[:space:]]*runTest\(' "$testFile")"
    local passed=0

    echo "=== $name ==="
    if ! gcc -Wall -std=c11 -g -o "$TMP/$name" "$file" "$testFile" "$ROOT"/adt/*.c "$TMP/unbuffered.c" 2> "$TMP/errors"; then
        cat "$TMP/errors"
        echo "Compile error"
    else
        cat "$TMP/errors"
        local output
        local status
        output="$(AUTOTEST=1 perl -e 'alarm shift; exec @ARGV' "$TIME_LIMIT" "$TMP/$name" 2>&1)"
        status=$?
        [ -n "$output" ] && echo "$output"
        passed="$(grep -cE 'PASS .*-> got' <<< "$output")"

        if [ "$status" -eq 142 ]; then
            echo "Timed out after ${TIME_LIMIT}s (infinite loop or too slow?)"
        elif [ "$status" -eq 139 ]; then
            echo "Crashed: segmentation fault"
        elif [ "$status" -eq 134 ]; then
            echo "Crashed: aborted"
        elif [ "$status" -gt 128 ]; then
            echo "Crashed: signal $((status - 128))"
        fi
    fi

    echo "Result: $passed/$tests passed"
    echo
    total_passed=$((total_passed + passed))
    total_tests=$((total_tests + tests))
}

selected=("${FILES[@]}")
single=false
if [ $# -gt 0 ]; then
    target="$(basename "${1%.c}")"
    if [[ " $TOPICS " == *" $target "* ]]; then
        selected=("$ROOT/$target"/*.c)
    else
        single=true
        selected=()
        for candidate in "${FILES[@]}"; do
            if [ "$(basename "$candidate" .c)" = "$target" ]; then
                selected=("$candidate")
            fi
        done

        if [ ${#selected[@]} -eq 0 ]; then
            echo "Unknown problem: $1"
            echo "Available problems:"
            for candidate in "${FILES[@]}"; do
                echo "  $(basename "$candidate" .c)"
            done
            exit 1
        fi
    fi
fi

for file in "${selected[@]}"; do
    run_problem "$file"
done
if [ "$single" = false ]; then
    echo "Total: $total_passed/$total_tests passed"
fi

[ "$total_passed" -eq "$total_tests" ]
